generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Student account (email + password login)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // UI language chosen at signup — bn | en | hi. The account's language is
  // LOCKED (owner decision): the locale switcher is gone, so this column is
  // the single source of truth for the session locale on every device.
  nativeLang   String?
  // null = student. "admin" = site operator (ADMIN_EMAILS env match on
  // login promotes). Admin-only Settings cards + APIs check this.
  role         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Key POOL (owner request: several Gemini keys per account; when one hits its
// quota the AI layer automatically moves to the next healthy key).
// Encrypted at rest (AES-256-GCM, same scheme as UserConfig.apiKeyEnc).
model UserApiKey {
  id            String    @id @default(cuid())
  userId        String
  apiKeyEnc     String // AES-256-GCM encrypted Gemini key
  keyPreview    String // masked preview e.g. "AIza...9f2"
  sortOrder     Int       @default(0) // lower = tried first
  // Cooldown after a quota/rate-limit failure — the rotation skips keys in
  // cooldown (hourly 429s) and returns them to the pool when it expires.
  cooldownUntil DateTime?
  failures      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

// User's own Gemini API key (encrypted at rest) + profile.
// Resolution: logged-in users read/write the row tagged with their userId
// (the key follows the ACCOUNT across devices); guests use the deviceId row.
model UserConfig {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  apiKeyEnc   String // AES-256-GCM encrypted Gemini API key
  keyPreview  String // masked preview e.g. "AIza...9f2"
  displayName String   @default("") // "" = no name; display surfaces localize their own fallback (src/lib/no-name.ts)
  level       String   @default("beginner") // beginner | intermediate | advanced
  goal        String   @default("general") // general | job | exam | travel | school (D9: shapes the weekly plan)
  dailyTarget Int      @default(10) // daily practice target in minutes (5|10|20) — D10 onboarding
  // D34 profile: emoji avatar key (src/lib/badges.ts AVATARS); "" = auto by level
  avatar      String   @default("")
  // D31 partner matching: OPT-IN visibility in /api/partners (privacy-first —
  // nobody appears in matching unless they explicitly turned this on)
  partnerOptIn Boolean @default(false)
  userId      String? // set when the device owner is logged in
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Generic cache for AI-generated content (grammar lessons, stories, quizzes)
model AiCache {
  id        String   @id @default(cuid())
  feature   String
  cacheKey  String
  response  String // JSON string
  createdAt DateTime @default(now())

  @@unique([feature, cacheKey])
}

// Daily vocabulary (3 words per device per date)
model DailyVocab {
  id        String   @id @default(cuid())
  deviceId  String
  date      String // YYYY-MM-DD (Asia/Dhaka)
  words     String // JSON: DailyWord[]
  createdAt DateTime @default(now())

  @@unique([deviceId, date])
}

// User's saved words
model WordBookItem {
  id        String   @id @default(cuid())
  deviceId  String
  word      String
  data      String // JSON: DailyWord
  userId    String?
  createdAt DateTime @default(now())

  @@unique([deviceId, word])
}

// Grammar lessons (AI-generated, cached per device)
// Speaking practice sessions (1:1, group, ai-partner)
model SpeakingSession {
  id           String   @id @default(cuid())
  deviceId     String
  type         String // one-to-one | group | ai-partner
  partnerCount Int      @default(1)
  durationSec  Int      @default(0)
  transcript   String // JSON: [{speaker, text, at}]
  analysis     String // JSON: CallAnalysis
  score        Int      @default(0)
  userId       String?
  createdAt    DateTime @default(now())
}

// Quiz / practice results (grammar-quiz, vocab-quiz, listening-quiz)
model PracticeLog {
  id        String   @id @default(cuid())
  deviceId  String
  kind      String
  refId     String
  score     Int
  total     Int
  userId    String?
  createdAt DateTime @default(now())
}

// One row per (device, local day) the app was actively used — the D11
// server-tracked streak. The day string (YYYY-MM-DD) is computed by the
// CLIENT in the device's own timezone, which makes the streak timezone-safe
// without ever storing the timezone itself (privacy-first). userId is
// attached when the visitor is signed in, so an account's streak can merge
// days across devices.
model ActivityDay {
  id        String   @id @default(cuid())
  deviceId  String
  userId    String?
  day       String // YYYY-MM-DD, client-local calendar day
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, day])
  @@index([userId, day])
  @@index([day])
}

// Web-push subscription (D12). One row per browser endpoint; the deviceId
// links it to the learner (userId attached when signed in) so the daily
// sender can personalize (locale) and decide streak-danger. Unsubscribes in
// Settings DELETE the row; gone endpoints (410) are pruned by the sender.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  deviceId  String
  userId    String?
  locale    String   @default("en") // en | bn | hi — notification language
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
}

// ─── Video call signaling (HTTP-polling based; Vercel-serverless friendly) ───

model CallRoom {
  id           String          @id @default(cuid())
  code         String          @unique // 6-char join code
  intent       String // "one" | "group"
  visibility   String          @default("public") // public (quick match) | private (code)
  // ─── D20 discovery + scheduled rooms ───
  // Free-text topic shown in the public room list ("Job interview practice").
  // Empty = a quick-match room (discovery shows a localized "Quick match").
  topic        String          @default("")
  // ISO instant this room is scheduled for. null = not scheduled. Scheduled
  // rooms sit in status "scheduled" (invisible to quick match + stale-prune)
  // until 5 minutes before the time, when code-join flips them open.
  scheduledFor DateTime?
  hostPeerId   String
  status       String          @default("open") // open | closed | scheduled
  maxPeers     Int             @default(4) // 2 for one-to-one
  lastSeq      Int             @default(0) // monotonic message cursor
  participants String          @default("[]") // JSON: [{peerId, name, deviceId, joinedAt}]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  messages     SignalMessage[]

  @@index([status, visibility, updatedAt])
  @@index([scheduledFor])
}

// ─── Zero-cost storage pool (rotation of free-tier storage accounts) ───
// The site owner can register several free-tier, S3-compatible storage
// accounts (Cloudflare R2, Backblaze B2, Scaleway…). Objects are uploaded to
// the first healthy account; when a provider reports a quota/limit error the
// pool automatically fails over to the next account. The owner can also
// switch manually. Public URLs stay stable via /api/media/<key> (302).

model StorageAccount {
  id            String   @id @default(cuid())
  label         String // e.g. "R2 account 1"
  provider      String   @default("s3") // s3 (S3-compatible)
  endpoint      String // e.g. https://<accountid>.r2.cloudflarestorage.com
  region        String   @default("auto")
  bucket        String
  accessKeyEnc  String // AES-256-GCM
  secretKeyEnc  String // AES-256-GCM
  publicBaseUrl String // public GET base, e.g. https://cdn.mysite.com
  limitBytes    Int      @default(0) // 0 = unknown
  status        String   @default("active") // active | exhausted | disabled
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Stable logical key -> physical location. Public URLs never change even
// when the underlying account is rotated.
model StorageObject {
  key       String   @id
  accountId String
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Video-call relay (TURN) pool ───
// Each Cloudflare account gives 1 TB/month of free TURN relay. The owner can
// register several TURN keys (keyId + API token, encrypted); /api/call/ice
// mints short-lived credentials from the active key and fails over to the
// next one when a key errors or its quota runs out.
model TurnKey {
  id          String   @id @default(cuid())
  label       String // e.g. "Cloudflare account 1 (billowing-lab-0d65)"
  keyId       String // Cloudflare TURN Token ID
  apiTokenEnc String // Cloudflare TURN API token (AES-256-GCM)
  status      String   @default("active") // active | exhausted | disabled
  sortOrder   Int      @default(0)
  // ─── D19 TURN health monitor ───
  // Persistent mint counters (fire-safe increments in turn-pool.ts). The
  // admin card surfaces them so the owner can SEE a dying key before a call
  // fails: rising mintFail / stale lastMintAt = replace the token.
  mintOk      Int      @default(0) // successful credential mints
  mintFail    Int      @default(0) // failed mint attempts (transient or dead)
  lastMintAt  DateTime? // last successful mint
  lastFailAt  DateTime? // last failed mint
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SignalMessage {
  id        Int      @id @default(autoincrement())
  roomId    String
  room      CallRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromPeer  String
  toPeer    String? // null = broadcast to all other peers
  type      String // offer | answer | ice | chat | caption | bye
  payload   String // JSON
  createdAt DateTime @default(now())

  @@index([roomId, id])
}

// ─── Owner-authored Library ───
// The site owner curates learning content (vocabulary, grammar lessons,
// listening stories) via the admin Content Studio. Learners browse ALL of it
// with ZERO API keys — AI (the learner's own Gemini key) is only used when
// they ask a question or check a sentence they wrote.

model LibraryVocab {
  id        String   @id @default(cuid())
  word      String
  level     String   @default("beginner") // beginner | intermediate | advanced
  category  String   @default("general") // general | daily | work | travel | academic
  data      String // JSON: LibraryVocabData (see src/lib/library-types.ts)
  unit      Int      @default(1) // learning-path unit within the level (1-5; 0 = extra practice)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([word, level])
  @@index([level])
}

model LibraryGrammar {
  id        String   @id @default(cuid())
  topic     String // canonical topic id (matches GrammarTopic.topic when it exists)
  level     String   @default("beginner") // beginner | intermediate | advanced
  title     String // display title (English base)
  data      String // JSON: LibraryGrammarData
  unit      Int      @default(1) // learning-path unit within the level (1-5; 0 = extra lesson)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([topic, level])
  @@index([level])
}

model LibraryListening {
  id        String   @id @default(cuid())
  slug      String   @unique
  level     String   @default("beginner") // beginner | intermediate | advanced
  category  String   @default("daily") // daily | travel | work | culture | science | inspire
  minutes   Int      @default(2)
  data      String // JSON: LibraryListeningData
  unit      Int      @default(0) // learning-path episode number within the level (1-5; 0 = standalone)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
}

model LibraryReading {
  id        String   @id @default(cuid())
  slug      String   @unique
  level     String   @default("beginner") // beginner | intermediate | advanced
  category  String   @default("daily") // daily | travel | work | culture | science | inspire
  minutes   Int      @default(3)
  data      String // JSON: LibraryReadingData
  unit      Int      @default(0) // learning-path episode number within the level (1-5; 0 = standalone)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
}

// ─── Product analytics (privacy-first, PII-free) ───
// One row = one user action (section visit, quiz complete, session start…).
// Day 1 of the 60-day business roadmap (ROADMAP-60.md). Privacy guarantees:
//   • NO IP, NO user-agent, NO email, NO free-text — the event name must be
//     in the server whitelist (src/lib/analytics.ts TRACK_EVENTS) and props
//     are flat, bounded, enum-ish values only.
//   • userId is attached server-side from the session cookie (never sent by
//     the client), so logged-in funnels work without storing identifiers
//     beyond the internal cuid.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String // whitelist: section_view | session_start | session_end | quiz_complete | speaking_session | ai_call | cv_export | app_install
  deviceId  String // localStorage bolo_device_id (random UUID, not a person)
  userId    String? // attached server-side from the session cookie
  props     String   @default("{}") // JSON, sanitized flat object (≤6 keys, values ≤80 chars)
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([deviceId, createdAt])
  @@index([userId, createdAt])
}

// ─── In-app feedback (D3, ROADMAP-60) ───
// One row = one submission from the floating feedback widget. Privacy:
//   • the message is USER-TYPED free text (their own choice what to include);
//     the server never auto-attaches email / IP / user-agent
//   • userId is attached server-side from the session cookie (like analytics)
//   • `page` is path-only (query string stripped → no tokens/PIE leak via URLs)
model Feedback {
  id        String   @id @default(cuid())
  category  String // bug | idea | problem (server whitelist)
  message   String // user-typed, ≤1000 chars
  status    String   @default("new") // new | seen | resolved (admin queue)
  page      String   @default("") // path-only, ≤120 chars, "" when unknown
  deviceId  String // submitter device (localStorage bolo_device_id)
  userId    String? // attached server-side from the session cookie
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([deviceId])
}

// ─── Session ratings + NPS (D4) ───
// Detached one-row-per-event table: how a session felt (1-5 after a call or
// quiz) and the weekly NPS pulse (0-10). No status workflow — immutable
// measurements. Privacy identical to Feedback: no IP/UA/email; userId is
// attached server-side from the session cookie.
model SessionRating {
  id        String   @id @default(cuid())
  kind      String // speaking | quiz | nps (server whitelist)
  score     Int // 1-5 session ratings; 0-10 NPS
  comment   String   @default("") // optional user-typed, ≤500 chars
  context   String   @default("") // path-only/topic tag, ≤120 chars, "" unknown
  deviceId  String // submitter device (localStorage bolo_device_id)
  userId    String? // attached server-side from the session cookie
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([deviceId, createdAt])
}

// ─── Client error monitoring (D5) ───
// One row = one client-side error report (error boundary, window.onerror, or
// unhandled promise rejection). Short, source-map-agnostic data only: the
// first line of the message, a trimmed stack, the Next.js digest token when
// present, and the path-only page. Privacy identical to the rest: no IP/UA/
// email; userId attached server-side from the session cookie.
model ClientError {
  id        String   @id @default(cuid())
  message   String // first line, ≤300 chars
  stack     String   @default("") // trimmed stack, ≤2000 chars
  digest    String   @default("") // Next.js digest token when present
  path      String   @default("") // path-only, ≤120 chars
  source    String   @default("boundary") // boundary | window | rejection
  deviceId  String
  userId    String? // attached server-side from the session cookie
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([deviceId, createdAt])
}

// ─── Weekly metrics digest (D6) ───
// One row per ISO week — a frozen JSON snapshot of the owner's week report
// (new users, active devices, learning totals, NPS, feedback, errors).
// Written by the Vercel cron (POST /api/digest with CRON_SECRET) or an
// admin; read by the WeeklyDigestCard. `data` is the digest JSON itself.
model MetricDigest {
  id        String   @id @default(cuid())
  weekKey   String   @unique // ISO week, e.g. "2026-W43"
  data      String // digest JSON snapshot
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── XP engine (D29, ROADMAP-60) ───
// One row = one XP grant. XP is ONLY minted at verified server write-points
// (practice logs, call sessions) or through the tightly-whitelisted client
// kind "lesson" (day-deduped by refId), never as a raw client-supplied
// number. Anti-abuse: per-kind daily caps + a global daily cap are enforced
// in src/lib/xp-server.ts BEFORE the row is written — capped grants either
// shrink or are skipped entirely (no row), so the ledger stays honest.
// Day bucketing uses the server's Asia/Dhaka calendar day (the product's
// home timezone) — the client never sends a day, so no timezone info exists
// anywhere in this table.
model XpEvent {
  id        String   @id @default(cuid())
  deviceId  String
  userId    String? // attached server-side from the session cookie
  kind      String // quiz | reading | dictation | review | call | lesson
  refId     String   @default("") // topic/story/session tag (lesson day-dedup key)
  xp        Int // granted XP (already clamped by the caps)
  day       String // YYYY-MM-DD (Asia/Dhaka) — bucket for caps + leaderboards
  createdAt DateTime @default(now())

  @@index([deviceId, day])
  @@index([userId, day])
  @@index([day])
  @@index([kind, refId, day])
}

// ─── Daily sentence challenge (D32, ROADMAP-60) ───
// One row = one learner's submission for the day's prompt (max 1 per device
// per Asia/Dhaka day — the (deviceId, day) unique). The text is USER-TYPED
// and PUBLIC to other learners (privacy-safe name only), so moderation
// (D33) gates visibility: `flagged` = auto word-list hit, `hidden` = hidden
// from the community feed until an admin unhides it.
model SentenceSubmission {
  id        String   @id @default(cuid())
  deviceId  String
  userId    String? // attached server-side from the session cookie
  day       String // YYYY-MM-DD (Asia/Dhaka) — the challenge day
  promptId  String // which prompt from src/lib/challenge-bank.ts
  text      String // ≤300 chars, English sentence(s)
  feedback  String   @default("") // JSON ChallengeFeedback | "" (AI, BYOK)
  hidden    Boolean  @default(false) // hidden from the feed (moderation)
  flagged   Boolean  @default(false) // auto-flagged by the word list
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, day])
  @@index([day, createdAt])
}

// Peer reactions on challenge submissions. One row per (submission, device);
// re-tapping the same emoji toggles it off (row deleted).
model SentenceReaction {
  id           String   @id @default(cuid())
  submissionId String
  deviceId     String
  userId       String?
  emoji        String // thumbs_up | heart | fire (server whitelist)
  createdAt    DateTime @default(now())

  @@unique([submissionId, deviceId])
  @@index([submissionId])
}

// ─── Moderation (D33, ROADMAP-60) ───
// Community content (challenge sentences, call rooms, partner profiles) can
// be reported by any learner. Reports land in the admin moderation queue
// (Settings → ModerationCard, ADMIN_EMAILS gate); `hide` actions flip the
// target row's hidden flag (sentences) or close the room (rooms).
model ContentReport {
  id        String   @id @default(cuid())
  targetType String  // sentence | room | profile (server whitelist)
  targetId  String // SentenceSubmission.id | CallRoom.id | UserConfig.id
  reason    String // spam | abuse | sexual | violence | other (whitelist)
  note      String   @default("") // optional, ≤200 chars
  reporterDeviceId String
  reporterUserId   String? // attached server-side
  status    String   @default("open") // open | reviewed | actioned
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// Device-level block list (D33). A block hides the other learner from YOUR
// partner suggestions AND their submissions from YOUR challenge feed —
// one-sided, silent, never notified.
model UserBlock {
  id              String   @id @default(cuid())
  deviceId        String // the blocker
  blockedDeviceId String // the blocked
  userId          String? // attached server-side
  createdAt       DateTime @default(now())

  @@unique([deviceId, blockedDeviceId])
  @@index([deviceId])
}

// ─── CV Studio ───
// Auto-generated, fully customizable CVs. One row = one CV; the entire
// content + design (template, accent, section order) lives in `data` as JSON
// (src/lib/cv/types.ts). Device-scoped like the rest of the guest data.
model CvDocument {
  id        String   @id @default(cuid())
  deviceId  String
  title     String   @default("আমার সিভি")
  data      String // JSON: CvData
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
}
